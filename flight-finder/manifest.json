{
  "manifest_version": 3,
  "name": "טיסות זולות - השוואת מחירים",
  "version": "0.4.0",
  "description": "קורא את החיפוש שלך באתר חברת תעופה ומציג מחירים מתחרים מאתרי השוואה.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.google.com/travel/flights*",
    "https://www.skyscanner.co.il/*",
    "https://www.kayak.com/*",
    "https://www.momondo.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "השוואת מחירי טיסות" }
}
